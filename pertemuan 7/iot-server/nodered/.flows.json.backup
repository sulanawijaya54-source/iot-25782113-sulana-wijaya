    {
        "id": "13f8dd3910f2dc1e",
        "type": "function",
        "z": "8b78cf58ab35920c",
        "name": "Histeresis Suhu",
        "func": "\nlet suhu = Number(msg.payload);\nlet led = context.get(\"led\") || 0;\n\nif (suhu > 31.5) {\n    led = 1;\n} else if (suhu < 30.0) {\n    led = 0;\n}\n\ncontext.set(\"led\", led);\n\nmsg.payload = {\n    led: led\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 260,
